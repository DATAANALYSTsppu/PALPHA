# Database
DATABASE_URL=postgresql://polymarket:polymarket_dev@localhost:5432/polymarket

# Polymarket APIs (public, no auth needed for read)
GAMMA_API_URL=https://gamma-api.polymarket.com
DATA_API_URL=https://data-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com

# Live Trading (optional - only needed for live mode)
POLY_PRIVATE_KEY=
POLY_FUNDER=            # proxy wallet that HOLDS the USDC
POLY_SIGNATURE_TYPE=2
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=

# Logging
LOG_LEVEL=info

# Dashboard
DASHBOARD_PORT=3000

# ─── API server (api-server.ts) ──────────────────────────────
# Port the dashboard API listens on
API_PORT=4001   # the dashboard expects 4001

# CORS — comma-separated list of allowed dashboard origins
DASHBOARD_ORIGIN=http://localhost:3000,http://localhost:3003,https://palpha.6116.ai

# ─── SSO via 6116.ai ─────────────────────────────────────────
# URL the api-server POSTs to with { platformName, platformApiKey } + Cookie header
AUTH_VERIFY_URL=https://6116.ai/api/auth/verify

# Our platform identifier registered with 6116
AUTH_PLATFORM_NAME=palpha

# API key issued by 6116 for our platform
AUTH_PLATFORM_API_KEY=

# Name of the cookie that 6116 sets (after user logs in)
AUTH_COOKIE_NAME=auth_session

# How long to cache verified SSO responses (ms). Default 5 min.
AUTH_CACHE_TTL_MS=300000

# Dev override — LOCAL ONLY. Set to 'true' to accept X-Dev-* headers
# in lieu of the SSO cookie. Never enable in production.
DEV_AUTH_OVERRIDE=true   # LOCAL ONLY — must be false in production

# MCP Server
MCP_ACCESS_TIER=read

# ── Price Re-Check Engine (needs migration 007_price_watchlist.sql) ──
# When a copy BUY can't fill inside the price limit, park it for 10 min and
# re-check at T+30s/2m/5m/8m/10m instead of dropping it. OFF by default.
SIMPLE_RECHECK_ENABLED=false
# Max slippage as a FRACTION of the target's price (0.12 = 12%).
# 0 = derive from SIMPLE_MAX_SLIPPAGE (recommended: same rule as the first attempt).
SIMPLE_RECHECK_MAX_SLIP_REL=0

# ── Shadow (paper) mode — NO real orders, no wallet keys needed ──
# Fills are simulated against Polymarket's REAL live order book (CLOB /book):
# a buy takes asks up to (target price + SIMPLE_MAX_SLIPPAGE); a sell takes bids.
# Use a SEPARATE database so shadow rows never mix with real ones.
# The bot refuses to start in shadow mode if CLOB_API_URL is not clob.polymarket.com.
SIMPLE_SHADOW_MODE=false
SIMPLE_MAX_SLIPPAGE=0.05

# ── Quality sizing: bigger bet for proven traders (works in shadow and live) ──
# A trader is QUALIFIED if, over their settled Polymarket positions,
#   ROI >= SIMPLE_QUAL_MIN_ROI over >= SIMPLE_QUAL_MIN_POSITIONS positions,
#   OR >= SIMPLE_QUAL_MIN_WINS winning positions with total $ won > total $ lost.
# Qualified traders get SIMPLE_QUALIFIED_BUY_USD per trade; everyone else the base size.
SIMPLE_QUALITY_SIZING=false
SIMPLE_QUALIFIED_BUY_USD=10
SIMPLE_QUAL_MIN_ROI=0.10
SIMPLE_QUAL_MIN_POSITIONS=30
SIMPLE_QUAL_MIN_WINS=50
SIMPLE_QUAL_REFRESH_MS=21600000
