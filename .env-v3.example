# ============================================================
# .env-v3 — Configuration for v3 database (parallel to .env for v2).
#
# Copy this file to .env-v3 and fill in real values.
# The v3 scripts (setup-v3-db.sh, scan-v3-fresh.sh) source this file.
#
# IMPORTANT: DATABASE_URL must point at polymarket_v3, not polymarket_v2.
#           The scripts will refuse to run if the URL doesn't contain 'v3'.
# ============================================================

# REQUIRED: PostgreSQL connection. NOTE: 'polymarket_v3' at the end.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/polymarket_v3?sslmode=require

# REQUIRED: Polygon RPC endpoint (same as .env)
POLYMARKET_RPC=https://your-rpc-endpoint
RPC_RATE_LIMIT=400
POLYGON_CHUNK_SIZE=500

# REQUIRED for live trading (same as .env)
POLY_PRIVATE_KEY=
POLY_FUNDER=
POLY_SIGNATURE_TYPE=2
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=

# Optional: Polymarket APIs (defaults are usually fine)
GAMMA_API_URL=https://gamma-api.polymarket.com
DATA_API_URL=https://data-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
API_DELAY_MS=200
API_PAGE_SIZE=100

# Optional: scan window override (defaults to 85104000 = ~30 days back)
# V3_FROM_BLOCK=85104000

# Optional: live trading config
LIVE_POSITION_SIZE=2
LIVE_MAX_POSITIONS=3
LIVE_MAX_PRICE=0.85
LIVE_MAX_HOURS_TO_RESOLUTION=24
LIVE_DAILY_LOSS_LIMIT=10
LIVE_POLL_INTERVAL=15000

LOG_LEVEL=info
