{
  "name": "polymarket-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/categories/*",
    "packages/dashboard",
    "packages/mcp-server"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "deploy": "bash scripts/deploy.sh",
    "scan:markets": "tsx packages/core/src/cli/scan-markets.ts",
    "scan:traders": "tsx packages/core/src/cli/scan-traders.ts",
    "scan:events:v2": "tsx packages/core/src/cli/scan-events-v2.ts",
    "scan:events:v2:all": "tsx packages/core/src/cli/scan-events-v2.ts --tag=sports && tsx packages/core/src/cli/scan-events-v2.ts --tag=weather",
    "scan:trades:v2": "tsx packages/core/src/cli/scan-trades-v2.ts",
    "ingest:wallet": "tsx packages/core/src/cli/ingest-wallet-trades.ts",
    "reconcile:fills": "tsx packages/core/src/cli/reconcile-fills.ts",
    "reconcile:positions": "tsx packages/core/src/cli/reconcile-positions.ts",
    "resolve:onchain": "tsx packages/core/src/cli/resolve-onchain.ts",
    "audit:fills": "tsx packages/core/src/cli/audit-inflated-fills.ts",
    "backfill:resolutions": "tsx packages/core/src/cli/backfill-resolutions.ts",
    "screen:band": "tsx packages/core/src/cli/screen-price-band.ts",
    "backtest:firstentry": "tsx packages/core/src/cli/backtest-firstentry-all.ts",
    "scan:trades:onchain": "tsx packages/core/src/cli/scan-trades-onchain.ts",
    "scan:trades:onchain:v2": "tsx packages/core/src/cli/scan-trades-onchain-v2.ts",
    "scan:prices:v2": "tsx packages/core/src/cli/scan-prices-v2.ts",
    "snapshot:positions": "tsx packages/core/src/cli/snapshot-positions.ts",
    "score": "tsx packages/core/src/cli/score-traders.ts",
    "alpha:score": "tsx packages/core/src/cli/score-alpha.ts",
    "alpha:leaderboard": "tsx packages/core/src/cli/show-alpha-leaderboard.ts",
    "leaderboard": "tsx packages/core/src/cli/show-leaderboard.ts",
    "copy:start": "tsx packages/core/src/cli/paper-trader.ts",
    "live:start": "tsx packages/core/src/cli/live-trader.ts",
    "live:redeem": "tsx packages/core/src/cli/redeem-positions.ts",
    "live:simple": "tsx packages/core/src/cli/simple-copy-trader.ts",
    "selftest:recheck": "tsx packages/core/src/cli/selftest-price-recheck.ts",
    "selftest:quality": "tsx packages/core/src/cli/selftest-quality-consensus.ts",
    "copy:status": "tsx packages/core/src/cli/paper-status.ts",
    "copy:add": "tsx packages/core/src/cli/manage-targets.ts",
    "backtest": "tsx packages/core/src/cli/run-backtest.ts",
    "db:migrate": "tsx packages/core/src/cli/migrate.ts",
    "db:check": "tsx packages/core/src/cli/check-db.ts",
    "db:query": "tsx packages/core/src/cli/db-query.ts",
    "dump:signals": "tsx packages/core/src/cli/dump-signals-30d.ts",
    "monitor": "tsx packages/core/src/cli/monitor.ts",
    "dashboard": "npm run dev --workspace=packages/dashboard",
    "api:start": "tsx packages/core/src/cli/api-server.ts",
    "mcp:start": "tsx packages/mcp-server/src/server.ts"
  },
  "devDependencies": {
    "docx": "^9.6.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@polymarket/clob-client": "^5.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "cors": "^2.8.6",
    "ethers": "^5.8.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  }
}
