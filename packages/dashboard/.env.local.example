# ============================================================
# .env.local — Dashboard env vars
# ============================================================
# Copy this file to .env.local and fill in real values.

# URL of the API server (api-server.ts). The api-server is reached at the
# root of its host — in production https://api.palpha.6116.ai (no `/api/`
# prefix). Locally the api-server listens on port 4001 by default.
NEXT_PUBLIC_API_URL=http://localhost:4001

# Where to redirect on 401 (unauthenticated) — SSO login page on 6116.ai.
# The ?redirect=... param tells 6116.ai where to send the user after login;
# adjust the value to match this deployment's dashboard origin.
NEXT_PUBLIC_AUTH_REDIRECT_URL=https://www.6116.ai/auth?redirect=https://palpha.6116.ai

# ── Dev auth override (LOCAL ONLY) ──────────────────────────
# When DEV_AUTH_OVERRIDE=true is set on api-server, the X-Dev-* headers below
# bypass cookie auth. Leave these BLANK in production.
NEXT_PUBLIC_DEV_USER_ID=dev-admin-001
NEXT_PUBLIC_DEV_ROLE=admin
NEXT_PUBLIC_DEV_USER_NAME=Admin User
NEXT_PUBLIC_DEV_USER_EMAIL=admin@palpha.6116.ai
