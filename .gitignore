# Guard: legacy non-(app) dashboard page directories.
# All pages live under packages/dashboard/src/app/(app)/. If these reappear
# as untracked files (e.g. from a stale checkout), Next.js fails the build
# with "two parallel pages that resolve to the same path". Ignoring them
# here means `git pull` never reintroduces them.
packages/dashboard/src/app/backtests/
packages/dashboard/src/app/positions/
packages/dashboard/src/app/signals/
packages/dashboard/src/app/traders/
